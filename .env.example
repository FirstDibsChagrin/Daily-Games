# Postgres connection used by the app at runtime (server-only, never sent to the browser).
# In production use the Supabase *transaction pooler* URL (port 6543) for the daily_league_app role:
#   postgres://daily_league_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://daily_league_app:app_password@localhost:5432/daily_league

# Admin connection used only by `npm run db:migrate` / `npm run db:seed` (optional; falls back to DATABASE_URL).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/daily_league
# Local dev only: lets db:migrate set the app role's password.
APP_ROLE_PASSWORD=app_password

# Secret used to sign device cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 24
CRON_SECRET=change-me

# Testing only. Never set in production: lets e2e tests fake the clock via a cookie.
# ALLOW_TEST_CLOCK=1
